{
  "extraKnownMarketplaces": {
    "keel": { "source": { "source": "github", "repo": "mckissinger/keel" } }
  },
  "enabledPlugins": { "keel@keel": true },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr merge:*)",

      "Bash(npx supabase migration *)",
      "Bash(npx supabase db diff:*)",
      "Bash(npx supabase db lint:*)",
      "Bash(npx supabase gen types:*)",
      "Bash(npx supabase projects list:*)",

      "Bash(npx vercel env ls:*)",
      "Bash(npx vercel env pull:*)",
      "Bash(npx vercel deploy --prebuilt:*)",
      "Bash(npx vercel inspect:*)",

      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run start:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx eslint:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",

      "Bash(scripts/check-plan.sh:*)",
      "Bash(scripts/check-verified-pin.sh:*)",
      "Bash(scripts/check-env.sh:*)",
      "Bash(scripts/repin.sh:*)"
    ]
  }
}
